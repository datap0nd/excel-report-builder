<UserControl x:Class="ExcelReportBuilder.AddIn.Views.PivotPlusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="320"
             MinHeight="480"
             Background="#FFFFFF"
             Foreground="#202124"
             FontFamily="Segoe UI"
             FontSize="12"
             Focusable="True"
             KeyboardNavigation.TabNavigation="Continue"
             AutomationProperties.Name="PivotTable Plus pane">
    <UserControl.InputBindings>
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding ApplyCommand}" />
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding UndoCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <SolidColorBrush x:Key="Rule" Color="#D7D7D7" />
        <SolidColorBrush x:Key="Subtle" Color="#F3F3F3" />
        <SolidColorBrush x:Key="Muted" Color="#616161" />
        <SolidColorBrush x:Key="Excel" Color="#217346" />
        <SolidColorBrush x:Key="ExcelHover" Color="#185C37" />

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="29" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#A6A6A6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F2F2F2" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.48" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="MinHeight" Value="31" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Background" Value="{StaticResource Excel}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Excel}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ExcelHover}" />
                    <Setter Property="BorderBrush" Value="{StaticResource ExcelHover}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.48" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="29" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BorderBrush" Value="#A6A6A6" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="29" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="BorderBrush" Value="#A6A6A6" />
        </Style>

        <Style x:Key="AreaList" TargetType="ListBox">
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="MaxHeight" Value="112" />
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <DataTemplate x:Key="PlacementTemplate">
            <Grid Margin="4,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Caption}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Margin="8,0,0,0"
                           Text="{Binding Aggregation}"
                           Foreground="{StaticResource Muted}"
                           FontSize="10" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1">
            <Grid Margin="12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="PivotTable+" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TargetLabel}"
                               Margin="0,2,0,0"
                               Foreground="{StaticResource Muted}"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.Name="Selected PivotTable" />
                    <TextBlock Text="{Binding SourceKindLabel}"
                               Foreground="{StaticResource Excel}"
                               FontSize="11" />
                </StackPanel>
                <Border Grid.Column="1"
                        Padding="7,3"
                        Background="#E7F3EC"
                        CornerRadius="10"
                        VerticalAlignment="Center">
                    <TextBlock Text="Live sync" Foreground="{StaticResource Excel}" FontSize="11" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12,10,12,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="PivotTable Fields" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="Open Excel Field List"
                            Command="{Binding OpenExcelFieldListCommand}"
                            AutomationProperties.Name="Open Excel's native PivotTable Fields pane" />
                </Grid>
                <TextBlock Text="Drag one or more fields into Filters, Columns, Rows, or Values. Drag placed fields to reorder or move them."
                           Margin="0,4,0,8"
                           Foreground="{StaticResource Muted}"
                           TextWrapping="Wrap" />
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Search PivotTable fields"
                         ToolTip="Search fields" />
                <ListBox ItemsSource="{Binding Fields}"
                         SelectedItem="{Binding SelectedField}"
                         SelectionMode="Extended"
                         MinHeight="90"
                         MaxHeight="170"
                         Margin="0,5,0,0"
                         BorderBrush="{StaticResource Rule}"
                         BorderThickness="1"
                         PreviewMouseLeftButtonDown="OnDragOriginMouseDown"
                         PreviewMouseMove="OnFieldListMouseMove"
                         AutomationProperties.Name="Available PivotTable fields">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Caption}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding KindLabel}" Foreground="{StaticResource Muted}" FontSize="10" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="Drop fields into an area" Margin="0,10,0,5" FontSize="14" FontWeight="SemiBold" />
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="Filters" Margin="0,0,0,3" Foreground="{StaticResource Muted}" />
                        <ListBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedPlacement}"
                                 ItemTemplate="{StaticResource PlacementTemplate}" Style="{StaticResource AreaList}"
                                 Tag="Filter" AllowDrop="True"
                                 PreviewMouseLeftButtonDown="OnDragOriginMouseDown"
                                 PreviewMouseMove="OnPlacementListMouseMove"
                                 PreviewKeyDown="OnPlacementKeyDown"
                                 DragOver="OnAreaDragOver" Drop="OnAreaDrop"
                                 AutomationProperties.Name="Filters drop area" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="Columns" Margin="0,0,0,3" Foreground="{StaticResource Muted}" />
                        <ListBox ItemsSource="{Binding Columns}" SelectedItem="{Binding SelectedPlacement}"
                                 ItemTemplate="{StaticResource PlacementTemplate}" Style="{StaticResource AreaList}"
                                 Tag="Column" AllowDrop="True"
                                 PreviewMouseLeftButtonDown="OnDragOriginMouseDown"
                                 PreviewMouseMove="OnPlacementListMouseMove"
                                 PreviewKeyDown="OnPlacementKeyDown"
                                 DragOver="OnAreaDragOver" Drop="OnAreaDrop"
                                 AutomationProperties.Name="Columns drop area" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
                        <TextBlock Text="Rows" Margin="0,0,0,3" Foreground="{StaticResource Muted}" />
                        <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedPlacement}"
                                 ItemTemplate="{StaticResource PlacementTemplate}" Style="{StaticResource AreaList}"
                                 Tag="Row" AllowDrop="True"
                                 PreviewMouseLeftButtonDown="OnDragOriginMouseDown"
                                 PreviewMouseMove="OnPlacementListMouseMove"
                                 PreviewKeyDown="OnPlacementKeyDown"
                                 DragOver="OnAreaDragOver" Drop="OnAreaDrop"
                                 AutomationProperties.Name="Rows drop area" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,8,0,0">
                        <TextBlock Text="Values" Margin="0,0,0,3" Foreground="{StaticResource Muted}" />
                        <ListBox ItemsSource="{Binding Values}" SelectedItem="{Binding SelectedPlacement}"
                                 ItemTemplate="{StaticResource PlacementTemplate}" Style="{StaticResource AreaList}"
                                 Tag="Values" AllowDrop="True"
                                 PreviewMouseLeftButtonDown="OnDragOriginMouseDown"
                                 PreviewMouseMove="OnPlacementListMouseMove"
                                 PreviewKeyDown="OnPlacementKeyDown"
                                 DragOver="OnAreaDragOver" Drop="OnAreaDrop"
                                 AutomationProperties.Name="Values drop area" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="Tip: press Delete to remove a selected placed field."
                           Margin="0,5,0,0"
                           Foreground="{StaticResource Muted}"
                           FontSize="10" />
                <Grid Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Preview only — Excel changes after confirmation."
                               Foreground="{StaticResource Muted}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="1"
                            Content="Apply"
                            Margin="8,0,0,0"
                            Command="{Binding ApplyCommand}"
                            Style="{StaticResource PrimaryButton}"
                            ToolTip="Apply preview (Ctrl+Enter)"
                            AutomationProperties.Name="Apply PivotTable preview" />
                </Grid>

                <Border Margin="0,16,0,0" BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" />
                <TextBlock Text="Extras" Margin="0,12,0,5" FontSize="14" FontWeight="SemiBold" />

                <Expander Header="Advanced engine" IsExpanded="False" Margin="0,2,0,0"
                          AutomationProperties.Name="Advanced engine feature">
                    <Border Padding="8" Background="#F7F7F7" BorderBrush="{StaticResource Rule}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Enable the workbook Data Model once to unlock validated measures and asymmetric layouts."
                                       TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
                            <Button Content="Enable PivotTable+"
                                    Margin="0,7,0,0" HorizontalAlignment="Left"
                                    Command="{Binding EnableDataModelCommand}"
                                    AutomationProperties.Name="Enable PivotTable Plus Data Model" />
                        </StackPanel>
                    </Border>
                </Expander>

                <Expander Header="Dates &amp; periods" IsExpanded="False" Margin="0,5,0,0"
                          AutomationProperties.Name="Dates and periods feature">
                    <Border Padding="8" Background="#F7F7F7" BorderBrush="{StaticResource Rule}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding PeriodSummary}" FontWeight="SemiBold" />
                            <TextBlock Text="Select several month fields with Ctrl or Shift, then drag them together into Values. Drag a Date, Month, Quarter, or Year field into Columns."
                                       Margin="0,3,0,6" TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
                            <ListBox ItemsSource="{Binding PeriodFields}"
                                     SelectedItem="{Binding SelectedPeriodField}"
                                     SelectionMode="Extended" MinHeight="42" MaxHeight="105"
                                     PreviewMouseLeftButtonDown="OnDragOriginMouseDown"
                                     PreviewMouseMove="OnFieldListMouseMove"
                                     AutomationProperties.Name="Detected date and period fields">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Caption}" Margin="4,3" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <WrapPanel Margin="0,7,0,0">
                                <Button Content="Month" Command="{Binding GroupDateCommand}" CommandParameter="Months" Margin="0,0,5,5" />
                                <Button Content="Quarter" Command="{Binding GroupDateCommand}" CommandParameter="Quarters" Margin="0,0,5,5" />
                                <Button Content="Year" Command="{Binding GroupDateCommand}" CommandParameter="Years" Margin="0,0,5,5" />
                                <Button Content="Ungroup" Command="{Binding GroupDateCommand}" CommandParameter="Ungrouped" Margin="0,0,5,5" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Expander>

                <Expander Header="Portion %" IsExpanded="False" Margin="0,5,0,0"
                          AutomationProperties.Name="Portion percent feature">
                    <Border Padding="8" Background="#F7F7F7" BorderBrush="{StaticResource Rule}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Add Portion % directly inside this native PivotTable. Each detail row is divided by its immediate parent."
                                       Margin="0,0,0,7" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                            <TextBlock Text="Value field" Foreground="{StaticResource Muted}" />
                            <ComboBox ItemsSource="{Binding PortionValueFields}"
                                      SelectedItem="{Binding SelectedPortionValueField}"
                                      DisplayMemberPath="Caption"
                                      AutomationProperties.Name="Portion numeric value field" />
                            <TextBlock Text="Detail row field" Margin="0,6,0,0" Foreground="{StaticResource Muted}" />
                            <ComboBox ItemsSource="{Binding PortionDetailFields}"
                                      SelectedItem="{Binding SelectedPortionDetailField}"
                                      DisplayMemberPath="Caption"
                                      AutomationProperties.Name="Portion detail row field" />
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Content="Add Portion %"
                                        Command="{Binding AddPortionCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.Name="Add Portion percent measure" />
                                <Button Grid.Column="1" Content="Undo"
                                        Command="{Binding UndoCommand}" Margin="6,0,0,0"
                                        ToolTip="Undo last extra (Ctrl+Shift+Z)"
                                        AutomationProperties.Name="Undo last PivotTable Plus extra" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="{StaticResource Subtle}"
                BorderBrush="{StaticResource Rule}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="8" Height="8" Fill="{StaticResource Excel}" Margin="0,3,8,0" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="PivotTable Plus status"
                           AutomationProperties.LiveSetting="Polite" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
